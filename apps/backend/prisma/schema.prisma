// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hero {
  id          Int      @id @default(autoincrement())
  heading1    String
  heading2    String?
  subheading  String?
  button1     String?
  button2     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkedWith {
  id        Int      @id @default(autoincrement())
  filename  String
  url       String
  extension String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Impact {
  id          Int      @id @default(autoincrement())
  value       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tool {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // "svg", "emoji", "text"
  content   String   // The svg string, emoji, or text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  image     String?
  initial   String?
  company   String?
  text      String
  metrics   Json?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Who We Are Page Sections ─────────────────────────────────────────────────

// Section 1: Who We Are (two paragraphs)
model WhoWeAreDescription {
  id          Int      @id @default(autoincrement())
  paragraph1  String
  paragraph2  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Section 2: Empowering Businesses (Mission section)
model EmpoweringBusiness {
  id          Int      @id @default(autoincrement())
  heading     String
  description String
  features    Json?    // Array of {title, desc} objects
  imageUrl    String?
  ctaText     String?
  ctaLink     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Section 3: Our Values
model OurValues {
  id          Int      @id @default(autoincrement())
  title       String
  desc        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Section 4: Global Presence
model GlobalPresence {
  id          Int      @id @default(autoincrement())
  city        String
  address     String?
  desc        String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Section 5: Origin Story
model OriginStory {
  id          Int      @id @default(autoincrement())
  heading     String
  paragraph1  String
  paragraph2  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Careers Page Sections ──────────────────────────────────────────────────

// 1. Building New
model CareerBuildingNew {
  id          Int      @id @default(autoincrement())
  heading     String
  description String
  features    Json?    // Array of {title, desc}
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 2. Suvrin Labs (Life at Suvrin labs)
model CareerSuvrinLabs {
  id          Int      @id @default(autoincrement())
  title       String
  desc        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 3. Work That Matters - Section Header
model CareerWorkThatMattersDesc {
  id          Int      @id @default(autoincrement())
  heading     String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 4. Work That Matters (Jobs)
model CareerJob {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   // e.g. "Design", "Software Development"
  categoryDesc String? // Description for the category
  location    String
  type        String   // e.g. "Full-time"
  desc        String
  dotColor    String   @default("bg-[#0546e0]")
  badgeBg     String   @default("bg-[#f0f4ff]")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Case Studies Page ────────────────────────────────────────────────────────

// Section 1: Hero – title, subtitle, tag, image, stats (results)
model CaseStudy {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  title       String
  subtitle    String?  // e.g. "Developed by Suvrin Technologies"
  tag         String?  // e.g. "Automation & Integration"
  imageUrl    String?
  client      String?
  industry    String?
  location    String?
  overview    String?  // short overview shown on the listing page

  // Section 2 – Client Overview (paragraphs)
  clientOverview  String?  // long text / can be multi-paragraph JSON array

  // Section 3 – Business Challenges
  // Array of { title: string, desc: string, points?: string[] }
  challenges      Json?

  // Section 4 – Suvrin's Solution
  // { intro: string[], modules: { title: string, items?: string[], body?: string }[] }
  solution        Json?

  // Section 5 – Stakeholders / special fourth section (varies per slug)
  // { heading: string, description?: string, list: string[] }
  stakeholders    Json?

  // Section 6 – Reporting & Analytics
  // { intro: string, items: string[] }
  reporting       Json?

  // Section 7 – Technology Stack
  // Array of { title: string, items: string[] }
  techStack       Json?

  // Section 8 – Key Outcomes & Business Impact
  // { categories: { title: string, color?: string, points: string[] }[], strategicBenefits: string[] }
  keyOutcomes     Json?

  // Section 9 – Key Features Delivered
  // Array of strings
  keyFeatures     Json?

  // Section 10 – Results Achieved
  // Array of { value: string, label: string }  (stats shown on hero) AND/OR
  // Array of strings for results list section
  results         Json?  // stats for hero: [{ value, label }]
  resultsAchieved Json?  // list for the Results Achieved section: string[]

  // Section 11 – Conclusion
  conclusion      String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
